<Page
    x:Class="LaserPointerWidget.LaserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
    Background="Transparent">
    <Grid Background="Transparent">
        <canvas:CanvasControl
            x:Name="Surface"
            ClearColor="#00000000"
            Draw="Surface_Draw"
            PointerEntered="Surface_PointerEntered"
            PointerExited="Surface_PointerExited"
            PointerPressed="Surface_PointerPressed"
            PointerMoved="Surface_PointerMoved"
            PointerReleased="Surface_PointerReleased"
            PointerCanceled="Surface_PointerReleased"
            PointerCaptureLost="Surface_PointerReleased" />
        <!-- While this is a prototype: what Game Bar is letting the widget do right now. -->
        <Border
            Margin="10"
            Padding="10,6"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="#B0101216"
            CornerRadius="8"
            IsHitTestVisible="False">
            <TextBlock x:Name="Status" FontSize="12" Foreground="#E6FFFFFF" />
        </Border>
    </Grid>
</Page>
