<Page
    x:Class="LaserPointerWidget.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0d0f14">
    <StackPanel MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock Text="Laser Pointer for Game Bar" FontSize="24" FontWeight="SemiBold" />
        <TextBlock TextWrapping="Wrap" Foreground="#a8afba"
                   Text="Press Win+G to open Xbox Game Bar, then choose Laser Pointer from the Widget menu. Draw with the left button while Game Bar is open; pin the widget to keep what you drew on top of the game." />
    </StackPanel>
</Page>
